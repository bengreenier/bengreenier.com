---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { links, projects } from '../data/site';

const github = links.find((l) => l.label === 'GitHub');
---

<Base current="projects" title="Projects" description="Side projects by Ben Greenier: real-time media, Rust, TypeScript and game mods.">
  <h1 class="title">Things I’ve made</h1>
  <p class="intro">
    A handful of side projects I’m proud of. Every one is open source, so feel free to tinker.
  </p>

  <ol class="index">
    {
      projects.map((p, i) => (
        <li>
          <a class:list={['project', 'sheets', { 'sheets--teal': i % 2 === 1 }]} href={p.url} data-energy data-stack>
            <span class="project-name">
              {p.name}
              <Arrow />
            </span>
            <span class="project-blurb">{p.blurb}</span>
            <span class="project-stack">
              <span class="visually-hidden">Built with </span>
              {p.stack.join(' · ')}
            </span>
          </a>
        </li>
      ))
    }
  </ol>

  {
    github && (
      <p class="more">
        <a class="pebble" href={github.url} data-energy>
          Everything else lives on GitHub
          <Arrow />
        </a>
      </p>
    )
  }
</Base>

<style>
  .title {
    margin: clamp(2rem, 6vh, 4.5rem) 0 0.3em;
    font-size: clamp(3rem, 11vw, 9rem);
    font-weight: 800;
    font-stretch: 75%;
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: var(--ink);
  }

  .intro {
    max-width: 40ch;
    margin: 0 0 clamp(2.5rem, 6vw, 4rem);
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    line-height: 1.3;
    font-weight: 500;
  }

  .index {
    --row-step: clamp(4px, 0.6vw, 7px);
    list-style: none;
    margin: 0;
    padding: 0 0 0 calc(6 * 1.9 * var(--row-step));
    display: grid;
    gap: calc(6 * 1.9 * var(--row-step) + 0.75rem);
  }

  .project {
    --step: var(--row-step);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.35rem 2.5rem;
    padding: clamp(1rem, 2.5vw, 1.6rem) clamp(1rem, 3vw, 2.25rem);
    text-decoration: none;
    color: var(--ink);
  }

  .project-name {
    display: inline-flex;
    align-items: baseline;
    gap: 0.25em;
    font-size: clamp(2.1rem, 6.5vw, 5.25rem);
    font-weight: 700;
    font-stretch: 78%;
    line-height: 0.95;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
    transition: font-weight 0.5s var(--ease-out);
  }

  .project-name :global(svg) {
    width: 0.4em;
    height: 0.4em;
    flex: none;
    opacity: 0.55;
    transition:
      opacity 0.3s var(--ease-out),
      transform 0.5s var(--ease-out);
  }

  .project:focus-visible .project-name {
    font-weight: 800;
  }

  .project:focus-visible .project-name :global(svg) {
    opacity: 1;
    transform: translate(0.08em, -0.08em);
  }

  /* Hover only where there is a real hover; touch gets no highlight. The stack
     fanning itself is driven by sheets.ts with the same rule. */
  @media (hover: hover) and (pointer: fine) {
    .project:hover .project-name {
      font-weight: 800;
    }

    .project:hover .project-name :global(svg) {
      opacity: 1;
      transform: translate(0.08em, -0.08em);
    }
  }

  .project-blurb {
    max-width: 62ch;
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    line-height: 1.45;
    text-wrap: pretty;
  }

  .project-stack {
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--ink-soft);
  }

  @media (min-width: 64rem) {
    .project {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      align-items: center;
    }

    .project-name {
      grid-row: span 2;
    }
  }

  .more {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }
</style>
