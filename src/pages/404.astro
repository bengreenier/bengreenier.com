---
import Base from '../layouts/Base.astro';
---

<Base current="none" title="Not found">
  <h1 class="lost">Page not found.</h1>
  <p class="hint">That page doesn’t exist, or it moved in the redesign.</p>
  <p><a class="pebble" href="/" data-energy>Back to the start</a></p>
</Base>

<style>
  .lost {
    margin: clamp(3rem, 12vh, 8rem) 0 0.3em;
    max-width: 12ch;
    font-size: clamp(3rem, 10vw, 8rem);
    font-weight: 800;
    font-stretch: 75%;
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: var(--accent-hot);
    -webkit-text-stroke: var(--ink-outline);
    paint-order: stroke fill;
  }

  .hint {
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    margin: 0 0 2rem;
    background: var(--ground);
    padding: 0.9rem 1.1rem;
    width: fit-content;
  }
</style>
