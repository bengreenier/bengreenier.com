---
import Base from '../layouts/Base.astro';
---

<Base current="none" title="Not found">
  <h1 class="lost">Nothing here but rock.</h1>
  <p class="hint">That page doesn’t exist, or it got buried in the redesign.</p>
  <p><a class="pebble" href="/" data-energy>Back to the start</a></p>
</Base>

<style>
  .lost {
    margin: clamp(3rem, 12vh, 8rem) 0 0.3em;
    max-width: 12ch;
    font-size: clamp(3rem, 10vw, 8rem);
    font-weight: 800;
    font-stretch: 75%;
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: var(--pink-hot);
  }

  .hint {
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    margin: 0 0 2rem;
  }
</style>
