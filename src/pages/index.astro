---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { links, person } from '../data/site';
---

<Base current="home">
  <section class="hero" aria-labelledby="name">
    <div class="sheets sheets--rise masthead" data-stack>
      <h1 id="name" class="name">
        <span class="mark" aria-hidden="true"></span>
        <span>Ben</span>
        <span>Greenier</span>
      </h1>
    </div>
    <div class="sheets sheets--teal panel" data-stack>
      <div class="bio">
        <p class="lede">
          Hi, I’m Ben. I’m a senior software engineer at <strong>Gather</strong>, and I work on side projects in my spare
          time.
        </p>
        <p>
          Right now I’m having fun creating Cities: Skylines II mods.
        </p>
      </div>
      <div class="actions">
        <a class="pebble cta" href="/projects" data-energy>See what I’m building</a>
        <ul class="social" aria-label={`${person.name} elsewhere`}>
          {
            links.map((link) => (
              <li>
                <a class="pebble pebble--quiet" href={link.url} rel="me noopener" data-energy>
                  {link.label}
                  <Arrow />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    gap: clamp(2.5rem, 7vw, 5rem);
    padding-top: calc(6 * 1.9 * var(--hero-step) + 1rem);
    --hero-step: clamp(6px, 1vw, 12px);
  }

  .sheets {
    --step: var(--hero-step);
  }

  .masthead {
    padding: clamp(1.25rem, 3vw, 2.5rem) clamp(1.25rem, 3vw, 2.5rem) clamp(1rem, 2.5vw, 2rem);
  }

  .name {
    margin: 0;
    font-size: clamp(3.75rem, 17vw, 12rem);
    font-weight: 800;
    font-stretch: 75%;
    line-height: 0.82;
    letter-spacing: -0.04em;
    color: var(--ink);
  }

  .name span:not(.mark) {
    display: block;
  }

  /* A small gold square, like the foil stamp on the poster. */
  .mark {
    display: block;
    width: 0.26em;
    height: 0.26em;
    margin-bottom: 0.12em;
    background: linear-gradient(135deg, #cdb874 0%, var(--gold) 45%, #7f6a2c 70%, #c4ad66 100%);
  }

  .panel {
    --ox: -0.6;
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    margin-left: calc(6 * 0.6 * 1.9 * var(--hero-step));
    margin-bottom: calc(6 * 1.9 * var(--hero-step));
    padding: clamp(1.25rem, 3vw, 2.5rem);
  }

  .bio {
    max-width: 34ch;
    font-size: clamp(1.3rem, 2.4vw, 2rem);
    line-height: 1.25;
    font-weight: 450;
    text-wrap: pretty;
  }

  .bio p {
    margin: 0 0 0.8em;
  }

  .bio p:last-child {
    margin-bottom: 0;
  }

  .bio .lede {
    font-weight: 650;
  }

  .bio strong {
    font-weight: 800;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 1.25rem 1.5rem;
  }

  .cta {
    font-size: clamp(1.15rem, 2vw, 1.5rem);
  }

  .social {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 64rem) {
    .masthead {
      margin-right: 18%;
    }

    .name {
      font-size: clamp(5rem, 9.5vw, 10rem);
    }

    .name span:not(.mark) {
      display: inline;
    }

    .name span:not(.mark) + span {
      margin-left: 0.22em;
    }

    .mark {
      display: inline-block;
      vertical-align: 0.55em;
      margin: 0 0.18em 0 0;
      width: 0.26em;
      height: 0.26em;
    }

    .panel {
      margin-left: 22%;
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      align-items: start;
    }

    .actions {
      flex-direction: column;
    }
  }
</style>
